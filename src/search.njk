---
title: "Search"
---

<h1>{{ title | safe }}</h1>

<label for="search" class="flow">
  <p class="label">Search books, films and telly by title, creator, cast, genre or shelf</p>
  <input
    class="search-input"
    autocomplete="off"
    type="search"
    id="search"
    placeholder="Type / to search"
    data-index="{{ '/search.json' | url }}"
  />
</label>
<div id="results" aria-live="polite"></div>

<template id="result-table">
  <table>
    <colgroup>
      <col class="title">
      <col class="creator">
      <col class="year">
    </colgroup>
    <thead>
      <tr>
        <th>Title</th>
        <th>Creator</th>
        <th>Year</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>
</template>

<template id="result-row">
  <tr>
    <td class="title"><a href=""></a></td>
    <td class="creator"></td>
    <td class="year"></td>
  </tr>
</template>

<template id="result-message">
  <p class="search-message"></p>
</template>

<script defer src="{{ '/js/search.js' | url }}"></script>
