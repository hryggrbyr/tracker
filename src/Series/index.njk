---
  layout: "base.njk"
---

<section class="flow">
    <h2>📺 All Telly</h2>
    {% set shelfBase = "series" %}
    {% include "shelf-nav.njk" %}
    <div class="grid">
    {% for show in Series | reverse %}
        {% set medium = show.frontmatter %}
        {% set slug = show.slug | slugify %}
        {% set path = "/series/" ~ slug %}
        {% include "shelf-cover.njk" %}
    {% endfor %}
</div>
</section>
