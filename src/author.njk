---
pagination:
  data: collections.booksByAuthor
  size: 1
  alias: author
eleventyComputed:
  permalink: "/authors/{{ author.slug }}/"
  title: "{{ author.name }}"
---
<h1>{{ author.name }}</h1>
<p>{{ author.books | length }} book{% if author.books | length != 1 %}s{% endif %} on this site.</p>

<section class="flow" style="--flow-gap: 1lh;">
  <h3>Books</h3>
  <div class="grid">
  {% for book in author.books %}
    {% set medium = book.frontmatter %}
    {% set slug = book.slug | slugify %}
    {% set path = "/books/" ~ slug %}
    {% include "shelf-cover.njk" %}
  {% endfor %}
  </div>
</section>

<p><a href="/authors/">← All authors</a></p>
