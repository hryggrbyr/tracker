<style>
@font-face {
  font-family: "Fraunces";
  src: url({{ "/fonts/Fraunces.woff2" | url }}) format("woff2");
  font-weight: 100 800;  /* match the font's actual weight axis range */
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Paper Mono";
  src: url({{ "/fonts/PaperMono.woff2" | url }}) format("woff2");
  font-weight: 100 800;  /* match the font's actual weight axis range */
  font-style: normal;
  font-display: swap;
}
:root {
  /* Enemy theme */
  --bg: #1a1608;
  --fg: #cfc59f;
  --muted: #93a3a6;
  --accent: #b6a746;
  --accent-bg: #6f9078;
  --border: #4a4219;
  --code-bg: #251f0b;
  --card-bg: #2d2711;
  --shadow: rgba(0, 0, 0, 0.3);
  --radius: 0;

  --chart-books: #93a3a6;
  --chart-films: #b6a746;
  --chart-telly: #6f9078;
  --chart-christmas: #c4675f;

  --font-family-main: "Paper Mono", cursive, sans-serif, system-ui;
  --font-family-accent: "Fraunces", monospace, serif;
  --font-family: var(--font-family-accent);
  --bar-color: var(--accent);

  color-scheme: dark;
  font-family: var(--font-family-main);
  line-height: 1.6;
}

/* Reset all border-radius */
* {
  border-radius: 0;
}

/* Global reset & base */
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  background-color: var(--bg);
  color: var(--fg);
  overflow-x: hidden;
}
body > header .wrapper {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 1rem;
}
body > header nav {
  margin-inline-start: auto;
}
body > header a[rel="home"] {
  font-size: 4em;
  font-family: var(--font-family-accent);
  font-weight: bold;
  display: grid;
  place-items: center center;
  margin-inline: auto;
  text-decoration: none;
  color: var(--fg);
}

.site-footer {
  border-top: 1px solid var(--border);
}
.site-footer .footer-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 1rem;
}
.site-footer .footer-grid .column {
  flex-basis: 30%;
  flex-grow: 1;
  flex-shrink: 1;
  min-width: max-content;
}

.wrapper {
  container-type: inline-size;
  width: 100%;
  margin-inline: auto;
}
@media screen and (min-width: 1280px) {
  .wrapper {
    max-width: 1280px;
  }
}
.gutters {
  padding-inline: 1rem;
}
.spacing {
  padding-block: 1lh;
}
.flow > * + * {
  margin-block-start: var(--flow-gap, 1lh);
}
a {
  color: var(--accent);
  text-decoration: underline;
}
a:hover {
  text-decoration: underline;
}
p {
  max-width: 67ch;
}
:is(h1, h2, h3, h4, h5, h6) {
  font-family: var(--font-family-accent);
}
h1 {
  line-height: 1.1;
  margin-block: 2lh;
  text-align: center;
}
h1 .meta {
  font-size: 1rem;
}
:is(h2, h3) {
  line-height: 1.1;
}
pre {
  width: 100%;
  overflow: auto;
  background: var(--code-bg);
  border: 1px solid var(--border);
  padding: 2ch;
}
nav {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}
nav > div {
  flex-grow: 1;
}
.button-group {
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 2ch;
}
.button-group > * {
  flex-grow: 1;
}
.conjoined {
  display: flex;
  gap: 0;
}
.conjoined :is(a, button) {
  appearance: none;
  border: 0;
  flex-grow: 1;
  text-transform: none;
  text-align: center;
  text-decoration: none;
  line-height: 1.1;
  padding-inline: 2ch;
  padding-block: 0.25lh;
  background-color: var(--accent-bg);
  color: var(--bg);
  font-weight: bold;
}
.conjoined.ghost :is(a, button) {
  background: none;
  font-size: 1.5em;
  border: 1px solid var(--accent);
}
.conjoined :is(a, button) + :is(a, button) {
  border-left: 1px solid currentColor;
}
.conjoined :is(a, button):first-of-type,
.conjoined :is(a, button):last-of-type {
  border-radius: 0;
}
table {
  width: 100%;
  display: block;
  overflow-x: auto;
  white-space: nowrap;
  font-variant-numeric: slashed-zero tabular-nums;
}
table tbody {
  display: inline-table;
  width: 100%;
}
table tr :is(th, td) {
  padding-inline: 2ch;
  padding-block: 0.25lh;
}
table tr:nth-child(odd):not(:has(th)) {
  background: rgba(0, 0, 0, 0.05);
}
table tr:has(th) {
  background: rgba(0, 0, 0, 0.5);
  color: var(--accent);
  text-align: left;
  font-size: 1.1em;
}
#results table {
  display: table;
  width: 100%;
  white-space: normal;
  table-layout: fixed;
}
#results table tbody { display: table-row-group; width: auto; }
#results table col.title { width: 55%; }
#results table col.creator { width: 35%; }
#results table col.year { width: 10%; }
#results table th,
#results table td { white-space: normal; }
#results table td.title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#results table td.year { text-align: right; font-variant-numeric: tabular-nums; }
#results table th:last-child { text-align: right; }
#results .search-message { margin-top: 1lh; opacity: 0.8; }

/* Search input — matches the site's bordered, monospace aesthetic */
.search-input {
  width: 100%;
  font-family: var(--font-family-main);
  font-size: 1.1em;
  color: var(--fg);
  background: var(--card-bg);
  border: 1px solid var(--border);
  padding: 0.75lh 1ch;
  outline: none;
}
.search-input::placeholder {
  color: var(--muted);
  opacity: 0.7;
}
.search-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 1px var(--accent);
}
.search-input::-webkit-search-cancel-button {
  -webkit-appearance: none;
  appearance: none;
}

.border {
  border: 1px solid var(--border);
  border-radius: 0;
}
a.border {
  text-decoration: none;
  text-align: center;
  padding-block: 0.5lh;
  padding-inline: 0.5em;
}
a.border:hover {
  text-shadow: 0 0 8px var(--fg);
}
details summary:hover {
  cursor: pointer;
}
:is(.card, .book-meta) details summary {
  margin-block-end: 1lh;
  font-style: italic;
}
:is(.card, .book-meta) details[open] summary {
  opacity: 0.5;
}
.txb-card {
  --border-color: var(--accent);
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 1lh;
  padding: 1lh;
}
.txb-card .column {
  flex-basis: 30%;
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 240px;
}
.column:has(figure) {
  min-width: min-content;
}
.column:has(figure) img {
  display: block;
  margin-inline: auto;
  width: 100%;
  max-width: 30rem;
  object-fit: contain;
}
.column:has(figure) figcaption {
  font-size: 0.8em;
  text-align: center;
  line-height: 1.1;
}
.column:has(.book-meta) {
  display: flex;
  flex-direction: column;
}
.column:has(.book-meta) h3 {
  font-size: 1.8em;
}
.column:has(.book-meta) h3 em {
  font-size: 0.6em;
}
.column:has(.book-meta) .link-wrapper {
  padding-block-start: 2lh;
  margin-block-start: auto;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 1rem;
}
.column:has(.book-meta) .link-wrapper a {
  --border-color: currentColor;
  flex-grow: 1;
  text-decoration: none;
  padding-block: 0.5lh;
  padding-inline: 0.5em;
  text-align: center;
}
.column .reading-meta {
  display: flex;
  flex-direction: column;
  height: 100%;
}
.column .reading-meta :first-child {
  margin-block-start: auto;
}
.grid {
  --width-card: 16rem;
  --max-cols: 3;
  --gap: 1rlh;

  display: grid;
  gap: var(--gap);
  grid-template-columns: repeat(
    auto-fill,
    minmax(
      max(var(--width-card), (100% - (var(--max-cols) - 1) * var(--gap)) / var(--max-cols)),
      1fr
    )
  );
}

.grid > * {
  min-width: 0;
}

.shelf-cover {
  --cut: 1rlh;
  content-visibility: auto;
  position: relative;
  display: flex;
  flex-direction: column;
  border-radius: var(--cut) 0 var(--cut) 0;
  corner-shape: bevel;
}

.shelf-cover .shelf-cover-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}
.shelf-cover .shelf-cover-overlay {
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 2;
  color: white;
  background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.9));
  display: flex;
  flex-direction: column;
}
.shelf-cover .top-meta {
display: flex; flex-direction: row; gap: 1ch;
  padding-block-end: 4rlh;
}
.shelf-cover .content {
  --flow-gap: 1lh;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: fit-content;
  padding: 2rem;
  padding: 1rlh;
  text-align: center;
  margin-block-start: auto;
  background: rgba(0,0,0,0.125);
  backdrop-filter: blur(4px);
}
.shelf-cover h4 {
  font-size: 2rem;
  line-height: 1.1;
}
.shelf-cover h4 .meta {
  font-family: var(--font-family-main);
  font-size: 1rem;
  font-style: normal;
  font-weight: 300;
}
.shelf-cover a {
  position: relative;
}
.shelf-cover a:before {
  content: '';
  position: absolute;
  inset: 0;
}
[class*="-indicator"] {
  text-transform: uppercase;
  padding: 0.25lh 1ch;
  font-size: 0.75em;
  font-weight: bold;
  --border-color: var(--fg);
}
[class*="-indicator"]:is(.shelf-watched, .shelf-read) {
  background-color: var(--bg);
  color: var(--fg);
}
[class*="-indicator"]:is(.shelf-watched, .shelf-reading) {
  background-color: var(--fg);
  color: var(--bg);
}
[class*="-indicator"]:is(.shelf-watchlist, .shelf-to-read) {
  background-color: var(--accent);
  color: var(--bg);
}
.shelf-cover[hidden] {
  display: none !important;
}
</style>
